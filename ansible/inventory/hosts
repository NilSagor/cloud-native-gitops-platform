# Copy to `hosts` (gitignored) and edit. Ubuntu 22.04+ hosts only.
#
#   cp ansible/inventory/hosts.example ansible/inventory/hosts
#
# Works the same for on-prem VMs and AWS EC2 instances: use the instance's
# public/private IP as ansible_host and the AMI's default user (ubuntu for
# Canonical Ubuntu AMIs), with the key pair passed via ansible_ssh_private_key_file.

[k8s_nodes]
k8s-node ansible_host=192.168.252.2 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_multipass

[k8s_nodes:vars]
docker_users=["$USER"]