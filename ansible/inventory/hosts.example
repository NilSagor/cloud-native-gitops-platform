# ansible/inventory/hosts.example
#
# Copy to `hosts` (gitignored) and replace the IP/key below.
#
#   cp ansible/inventory/hosts.example ansible/inventory/hosts
#
# Works for Multipass VMs, on-prem Ubuntu, and AWS EC2 (Ubuntu AMIs):
#   - ansible_host            = VM / instance IP
#   - ansible_user            = `ubuntu` (default on both Multipass and Canonical AMIs)
#   - ansible_ssh_private_key_file = path to your key on this machine

[k8s_nodes]
k8s-node ansible_host=192.168.64.5 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_multipass